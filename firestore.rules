rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and ownership
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Schema validation for an inventory item
    function isValidItem(data) {
      return data.name is string 
        && data.name.size() >= 1 
        && data.name.size() <= 100
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500))
        && data.category is string 
        && data.category.size() >= 1 
        && data.category.size() <= 50
        && (data.quantity is number && data.quantity >= 0)
        && (data.price is number && data.price >= 0)
        && (!('lastMovementId' in data) || data.lastMovementId is string)
        && (!('lowStockThreshold' in data) || (data.lowStockThreshold is number && data.lowStockThreshold >= 0));
    }

    // The movement doc named by item.lastMovementId must be created in the same
    // batch/transaction and match the item's quantity change (audit binding).
    function movementMatches(userId, itemId, lastId, prevQty, newQty) {
      let path = /databases/$(database)/documents/users/$(userId)/movements/$(lastId);
      return !exists(path)
        && existsAfter(path)
        && getAfter(path).data.itemId == itemId
        && getAfter(path).data.previousQuantity == prevQty
        && getAfter(path).data.newQuantity == newQty;
    }

    /**
     * User-isolated inventory subcollection.
     * Only the authenticated owner can read, query, create, update, or delete items.
     * Public access is completely denied.
     */
    match /users/{userId}/items/{itemId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidItem(request.resource.data)
        && request.resource.data.lastMovementId is string
        && movementMatches(userId, itemId, request.resource.data.lastMovementId, 0, request.resource.data.quantity);
      allow update: if isOwner(userId) && isValidItem(request.resource.data)
        && (request.resource.data.quantity == resource.data.quantity
          || (request.resource.data.lastMovementId is string
            && movementMatches(userId, itemId, request.resource.data.lastMovementId,
                               resource.data.quantity, request.resource.data.quantity)));
      allow delete: if isOwner(userId);
    }

    /**
     * User-isolated immutable stock movements audit trail.
     * Only the authenticated owner can read and append audit logs.
     * Modification and deletion are strictly forbidden for tamper-proof auditing.
     */
    match /users/{userId}/movements/{movementId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if false; // Immutable audit log
    }
  }
}
