/**
 * This ruleset defines the security model for a public catalog application.
 *
 * Core Philosophy:
 * The security model is "Public Read, Authenticated Write". This means that all
 * data is publicly visible to any client, including unauthenticated users.
 * However, any action that modifies data (creating, updating, or deleting)
 * requires the user to be signed in. This provides a secure baseline for a
 * professional application by preventing anonymous vandalism while allowing
 * open access for viewers.
 *
 * Data Structure:
 * The data is stored in a top-level collection `/items`.
 * - /items/{itemId}
 *
 * Key Security Decisions:
 * - Public Read Access: To support a public-facing catalog, `get` and `list`
 *   operations are permitted for everyone.
 * - Authenticated Writes: All write operations (`create`, `update`, `delete`) are
 *   restricted to signed-in users (`request.auth != null`). This is a foundational
 *   security measure.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated.
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Manages inventory items. Publicly readable, but only
     *              authenticated users can create, update, or delete them.
     * @path /items/{itemId}
     * @allow (get, list) Any user, signed in or not, can read item data.
     * @allow (write) Any signed-in user can create, update, or delete an item.
     * @deny (write) An unauthenticated user attempts to modify an item.
     */
    match /items/{itemId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }
  }
}
