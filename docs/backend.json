{
  "entities": {
    "Item": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Item",
      "type": "object",
      "description": "Represents an item in the inventory.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the item."
        },
        "name": {
          "type": "string",
          "description": "Name of the item."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the item."
        },
        "quantity": {
          "type": "number",
          "description": "Current quantity of the item in stock."
        },
        "category": {
          "type": "string",
          "description": "Category of the item."
        },
        "price": {
          "type": "number",
          "description": "Price of the item."
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "quantity",
        "category",
        "price"
      ]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/items/{itemId}",
        "definition": {
          "entityName": "Item",
          "schema": {
            "$ref": "#/backend/entities/Item"
          },
          "description": "Stores item data. Includes 'itemId' as the unique item identifier.",
          "params": [
            {
              "name": "itemId",
              "description": "Unique identifier for the item."
            }
          ]
        }
      }
    ]
  }
}
